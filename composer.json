{
    "name": "keenthemes/metronic-laravel",
    "type": "project",
    "description": "The Metronic in the Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "aamdsam/bridging-bpjs": "^1.12",
        "agumil/satusehat-sdk": "^0.8.1",
        "anlutro/l4-settings": "^1.0",
        "barryvdh/laravel-dompdf": "^2.0",
        "daengdeni/log-reader": "^2.4",
        "guzzlehttp/guzzle": "^7.2",
        "haruncpi/laravel-id-generator": "^1.1",
        "ivanwilliammd/satusehat-integration": "^3.0",
        "laravel/framework": "^11.0",
        "laravel/passport": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.6",
        "laravel/tinker": "^2.8",
        "maatwebsite/excel": "^3.1",
        "mockery/mockery": "1.6.7",
        "nullpunkt/lz-string-php": "^1.3",
        "nwidart/laravel-modules": "^10.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-html": "*",
        "spatie/laravel-permission": "^6.0",
        "vlucas/phpdotenv": "^5.6",
        "webklex/laravel-pdfmerger": "^1.3",
        "yajra/laravel-datatables": "^11.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.9",
        "barryvdh/laravel-ide-helper": "^3.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/boost": "^1.0",
        "laravel/breeze": "^2.0",
        "laravel/sail": "^1.18",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^10.1",
        "spatie/laravel-ignition": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "barryvdh/laravel-ide-helper"
            ]
        },
        "google/apiclient-services": [
            "Drive",
            "Sheets",
            "Script"
        ]
    },
    "autoload": {
        "files": [
            "app/helpers.php",
            "app/satusehat.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ]
    },
    "repositories": []
}
